# App (src/backend/shared/config/env.config.ts)
PORT=
NODE_ENV=development
# Host port of the pod's Postgres (5433), not 5432
DATABASE_URL=
VALKEY_URL=
# Required when NODE_ENV=production; generate with: openssl rand -base64 32
JWT_SECRET=

# Podman pod host ports (scripts/pod.ts)
POD_APP_PORT=
POD_DB_PORT=
POD_CACHE_PORT=

RATE_LIMIT_IP_CAPACITY=
RATE_LIMIT_IP_REFILL=
RATE_LIMIT_USER_CAPACITY=
RATE_LIMIT_USER_REFILL=