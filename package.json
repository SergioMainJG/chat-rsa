{
  "name": "chat-rsa",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build src/backend/main.ts --target bun --outdir dist",
    "dev": "bun --hot src/backend/main.ts --hostname 0.0.0.0",
    "pod:down": "bun scripts/pod.ts down",
    "pod:infra": "bun scripts/pod.ts infra",
    "pod:logs": "bun scripts/pod.ts logs",
    "pod:status": "bun scripts/pod.ts status",
    "pod:up": "bun scripts/pod.ts up",
    "start": "NODE_ENV=production bun src/backend/main.ts",
    "test:e2e": "bun test ./test/e2e",
    "test:integration": "bun test ./test/integration --pass-with-no-tests",
    "test:load": "bun scripts/load.ts",
    "test:load:probes": "bun test ./test/load --timeout 180000 --reporter=junit --reporter-outfile=test-load-auth.xml",
    "test:unit": "bun test ./src --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "verify": "bun fmt --check && bun lint --max-warnings 0 && bun run typecheck && bun run test:unit"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/k6": "2.3.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-unicorn": "79.0.0",
    "typescript": "7.1.0-beta"
  },
  "packageManager": "bun@1.4.4"
}
